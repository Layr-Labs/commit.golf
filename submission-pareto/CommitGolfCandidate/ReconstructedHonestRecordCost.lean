def cut (pc : Word) := pc == addr 143 || pc == addr 1429
private def zero (pc : Word) := pc == addr 184
private abbrev active := HonestBinaryRank.active costs
private abbrev rank := HonestBinaryRank.rank costs

private theorem ranked : Ranking (Artifact.submission.image .opening) active cut zero rank :=
  HonestBinaryRank.of_table _ Artifact.openingCode (Eq.refl (ArtifactEncoding.decode 32 _))
    (by decide) costs cut zero (by decide +kernel)

/-- Starting at the first instruction of any legal or faulting record, every
actual execution pays at most 1,190 cycles in addition to its continuation at
the next record or cap. The bound permits arbitrary data-dependent branches. -/
theorem record (tail : Nat) (s : MachineState) (pc : s.pc = 4668) (coins : Bool)
    (boundary : ∀ t : MachineState, t.pc = 4668 ∨ t.pc = 9812 → ∀ f r,
      r ∈ support (execute (Artifact.submission.image .opening) f t coins) → r.cycles ≤ tail)
    (fuel : Nat) (r : Execution)
    (run : r ∈ support (execute (Artifact.submission.image .opening) fuel s coins)) : r.cycles ≤ 1190 + tail := by
  have start : active s.pc = true := by rw [pc]; decide +kernel
  have safe : zero s.pc = true → s.getReg .x5 = 0 := by rw [pc]; intro h; cases h
  have bound := bounded _ _ _ _ _ ranked coins tail (fun t h => boundary t (by
    simpa only [cut,Bool.or_eq_true,beq_iff_eq,show addr 143 = 4668 by rfl,
      show addr 1429 = 9812 by rfl] using h)) s start safe fuel r run
  have left : rank s.pc = 1190 := by rw [pc]; decide +kernel
  rwa [left] at bound

/-- The per-record price with a continuation restricted to states reached from this
particular input. A loop invariant can use the memory and register values of that state. -/
theorem record_path (tail : Nat) (s : MachineState) (pc : s.pc = 4668) (coins : Bool)
    (boundary : ∀ t : MachineState, HonestCuts.Reaches (Artifact.submission.image .opening) coins cut s t →
      ∀ f r, r ∈ support (execute (Artifact.submission.image .opening) f t coins) → r.cycles ≤ tail)
    (fuel : Nat) (r : Execution)
    (run : r ∈ support (execute (Artifact.submission.image .opening) fuel s coins)) : r.cycles ≤ 1190 + tail := by
  have start : active s.pc = true := by rw [pc]; decide +kernel
  have safe : zero s.pc = true → s.getReg .x5 = 0 := by rw [pc]; intro h; cases h
  have bound := HonestCuts.bounded ranked s coins tail start safe boundary fuel r run
  have left : rank s.pc = 1190 := by rw [pc]; decide +kernel
  rwa [left] at bound

theorem record_success {good : MachineState→Prop} (s : MachineState) (pc : s.pc=4668) (coins : Bool)
    (boundary : ∀ t, HonestCuts.Reaches (Artifact.submission.image .opening) coins cut s t →
      HonestFinishes.SuccessPost (Artifact.submission.image .opening) coins good t) :
    HonestFinishes.SuccessPost (Artifact.submission.image .opening) coins good s :=
  HonestFinishes.from_cut ranked s coins (by rw [pc]; decide +kernel) (by rw [pc]; intro h; cases h) boundary

private def publicRemaining (pc : Word) : Nat :=
  if 143≤HonestBinaryRank.index pc ∧ HonestBinaryRank.index pc≤184 then 1 else 0

theorem record_calls (tail : Nat) (s : MachineState) (pc : s.pc=4668) (coins : Bool)
    (boundary : ∀ t, HonestCuts.Reaches (Artifact.submission.image .opening) coins cut s t →
      HonestCallFlow.Calls (Artifact.submission.image .opening) t coins tail) :
    HonestCallFlow.Calls (Artifact.submission.image .opening) s coins (1+tail) := by
  have entry : active s.pc=true := by rw [pc]; decide +kernel
  have safe : zero s.pc=true → s.getReg .x5=0 := by rw [pc]; intro h; cases h
  have h := HonestCallFlow.bounded _ Artifact.openingCode costs (Eq.refl (ArtifactEncoding.decode 32 _))
    (by decide) cut zero publicRemaining ranked (by decide +kernel) s entry safe coins tail boundary
  have left : publicRemaining s.pc=1 := by rw [pc]; decide +kernel
  simpa only [left] using h

end CommitGolfCandidate.Reconstruction.HonestRecordCost
