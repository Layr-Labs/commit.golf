    (decoded : (openingImage.code[index]?).bind decodeInstruction = some (.base instruction)) :
    fetch openingImage state = some (.base instruction) := by
  have pcNat : state.pc.toNat = 4096 + 4 * index := by
    rw [pc, BitVec.toNat_ofNat, Nat.mod_eq_of_lt]
    omega
  rw [fetch, pcNat, ite_eq_left (by omega)]
  rw [show (4096 + 4 * index - 4096) / 4 = index by omega]
  cases word : openingImage.code[index]? with
  | none => simp [word] at decoded
  | some word => simpa [word] using decoded

/-- The nonempty branch skips the jump to the shared return block. -/
def setupInstructions : List Instr :=
  [.ADDI .x20 .x15 0, .ADDI .x21 .x15 0, .BNE .x16 .x0 76,
   .ADDI .x8 .x13 0, .ADDI .x9 .x12 0, .ADDI .x18 .x16 0,
   .LUI .x19 4096, .LUI .x22 327680, .ADD .x22 .x9 .x22,
   .ADDI .x23 .x0 1, .LUI .x26 1, .ADDI .x27 .x0 256]

def nonceInstructions : List Instr :=
  [.LD .x6 .x8 0, .SLLI .x7 .x6 4, .ADD .x7 .x22 .x7,
   .LD .x31 .x7 0, .SD .x21 .x31 0, .LD .x31 .x7 8, .SD .x21 .x31 8,
   .ADD .x6 .x6 .x19]

def storeOffset (level word : Nat) : BitVec 12 := BitVec.ofNat 12 (16 + 32*level + 8*word)

def siblingInstructions (level : Nat) : List Instr :=
  [.XORI .x7 .x6 1, .SLLI .x7 .x7 5, .ADD .x7 .x9 .x7,
   .LD .x31 .x7 0, .SD .x21 .x31 (storeOffset level 0), .LD .x31 .x7 8, .SD .x21 .x31 (storeOffset level 1),
   .LD .x31 .x7 16, .SD .x21 .x31 (storeOffset level 2), .LD .x31 .x7 24, .SD .x21 .x31 (storeOffset level 3),
   .SRLI .x6 .x6 1]

def recordTailInstructions : List Instr :=
  [.ADDI .x21 .x21 528, .SLLI .x7 .x6 3, .ADD .x7 .x26 .x7, .SD .x7 .x23 0,
   .ADDI .x8 .x8 8, .ADDI .x18 .x18 4095, .BNE .x18 .x0 7368]

def decodeBase (word : BitVec 32) : Option Instr :=
  (decodeInstruction word).bind fun
    | .base instruction => some instruction
    | _ => none

/-- The assembled prefix contains sixteen straight-line sibling copies. -/
theorem opening_prefix_decoded :
    ((openingImage.code.take 237).map decodeBase) =
      ((setupInstructions.take 3 ++ [Instr.JAL .x0 1088] ++ List.replicate 17 (Instr.ADDI .x0 .x0 0) ++ setupInstructions.drop 3 ++
        nonceInstructions ++ ((List.range 16).flatMap siblingInstructions) ++
        recordTailInstructions).map some) := by
  decide

theorem nonce_decode (i : Fin 8) :
    (openingImage.code[30 + i.val]?).bind decodeInstruction =
      some (.base (nonceInstructions[i.val]?.getD .EBREAK)) := by
  fin_cases i <;> rfl

theorem sibling_decode : ∀ (level : Fin 16) (i : Fin 12),
    (openingImage.code[38 + 12 * level.val + i.val]?).bind decodeInstruction =
      some (.base ((siblingInstructions level.val)[i.val]?.getD .EBREAK)) := by
  intro level i
  fin_cases level <;> fin_cases i <;> rfl

end TwoPermutationPrototype.Opening
