def fixedTail : List (BitVec 32) := [806128787, 9178131, 4294806931, 2987237091, 1090291123, 1049235, 1299, 115]
def fixedImage : Image := ⟨fixedHead ++ (List.range 24).flatMap fixedBody ++ fixedTail,[]⟩
theorem fixed_path_fetched (level i : Nat) (bound : level<24) (inside : i<12)
    (s : MachineState) (pc : s.pc=BitVec.ofNat 64 (4232+48*level+4*i)) :
    fetch fixedImage s=some (.base (((fixedPathInstructions level)[i]?).getD .EBREAK)) := by
  have pcNat : s.pc.toNat=4232+48*level+4*i := by
    rw [pc,BitVec.toNat_ofNat,Nat.mod_eq_of_lt]
    omega
  rw [fetch,pcNat,if_pos (by omega)]
  have index : (4232+48*level+4*i-4096)/4=34+12*level+i := by omega
  rw [index]
  interval_cases level <;> interval_cases i <;> rfl
theorem fixed_fetch (s : MachineState) (index : Nat) (instruction : Instr)
    (bound : index<330) (pc : s.pc=BitVec.ofNat 64 (4096+4*index))
    (decoded : (fixedImage.code[index]?).bind decodeInstruction=some (.base instruction)) :
    fetch fixedImage s=some (.base instruction) := by
  have pcNat : s.pc.toNat=4096+4*index := by
    rw [pc,BitVec.toNat_ofNat,Nat.mod_eq_of_lt];omega
  rw [fetch,pcNat,if_pos (by omega)]
  have idx : (4096+4*index-4096)/4=index := by omega
  rw [idx]
  cases h : fixedImage.code[index]? with
  | none => simp [h] at decoded
  | some word => simpa [h] using decoded

