/-- `lui` page of the level-`k` group base plus 40. -/
def groupPage (k : Nat) : Nat := (pentaGroupBase k + 40) / 4096

/-- `n` doubleword load/store pairs from `x7` to `x21`. -/
def pairCode (n : Nat) : List Instr :=
  (List.range n).flatMap fun w => [.LD .x31 .x7 (BitVec.ofNat 12 (8*w)), .SD .x21 .x31 (BitVec.ofNat 12 (8*w))]

def setupCode : List Instr :=
  [.ADDI .x21 .x15 0, .BEQ .x16 .x0 588, .JAL .x0 1908, .ADDI .x9 .x12 0,
   .ADDI .x18 .x16 0, .LUI .x22 442369, .ADD .x22 .x9 .x22, .ADDI .x19 .x0 5, .ADDI .x23 .x0 368,
   .LUI .x26 1, .ADDI .x26 .x26 636]

def saltHead : List Instr := [.LD .x6 .x8 0, .SLLI .x7 .x6 4, .ADD .x7 .x22 .x7]

/-- Register holding the address of the level-`k` copy-variant table (`x7 = 256 r + tableReg k`). -/
def tableReg : Nat → Reg
  | 0 => .x5
  | 1 => .x17
  | 2 => .x20
  | 3 => .x26
  | 4 => .x28
  | _ => .x29

/-- First word of the level-`k` copy variant `v` (64-word stride, 320 words per level). -/
def levelVariantStart (k v : Nat) : Nat := 3072+320*k+64*v

/-- Value held by `tableReg k` during the record loop: the pair-variant tables (`k = 0, 1, 2`), the
divisor `25` (`k = 3`) and the level-6 variant table (`k ≥ 4`). -/
def tableStart : Nat → Nat
  | 0 => 28672
  | 1 => 45056
  | 2 => 61440
  | 3 => 25
  | 4 => 125
  | _ => 4096+4*levelVariantStart 6 0

/-- Words 25-31: the three pair tables, the divisor 25 and the level-6 table address. -/
def tableCode : List Instr :=
  [.LUI .x5 7, .LUI .x17 11, .LUI .x20 15, .ADDI .x26 .x0 25, .LUI .x29 6, .ADDI .x29 .x29 (-512),
   .ADDI .x28 .x0 125]

/-- Words 32-33: `x18 := indices + 8 · count`, the end of the index buffer. -/
def endCode : List Instr := [.SLLI .x18 .x18 3, .ADD .x18 .x18 .x8]

/-- The record salt: two doublewords at offsets 0 and 8 of the record; `x21` stays at the record. -/
def saltCode : List Instr := saltHead ++ pairCode 2

/-- Level `k` reads node `index / 5^k` from `nodeReg k` and writes its parent into `nodeReg (k+1)`. -/
def nodeReg (j : Nat) : Reg := if j % 2 = 0 then .x6 else .x24

/-- Register holding `trapdoor + pentaGroupBase k + 40` for record levels `k = 0 … 6`. -/
def baseReg : Nat → Reg
  | 0 => .x2
  | 1 => .x3
  | 2 => .x4
  | 3 => .x12
  | 4 => .x13
  | 5 => .x14
  | _ => .x16

/-- Words 11-24: load the seven level group bases once, before the first record. -/
def baseCode : List Instr :=
  (List.range 7).flatMap fun k =>
    [.LUI (baseReg k) (BitVec.ofNat 20 (groupPage k)), .ADD (baseReg k) (baseReg k) .x9]

/-- Head of a level reading node register `a` and writing the parent into `b`. -/
def headWith (a b base : Reg) : List Instr :=
  [.DIVU b a .x19, .SLLI .x25 b 2, .ADD .x25 .x25 b, .SUB .x25 a .x25, .MUL .x10 b .x23, .ADD .x30 .x10 base]

def levelHead (k : Nat) : List Instr := headWith (nodeReg k) (nodeReg (k+1)) (baseReg k)

def dispatchCode (k : Nat) : List Instr := [.SLLI .x7 .x25 8, .ADD .x7 .x7 (tableReg k)]

def levelCode (k : Nat) : List Instr :=
  levelHead k ++ dispatchCode k ++ [.JALR .x0 .x7 0]

def tailCode : List Instr := [.ADDI .x8 .x8 8, .BNE .x8 .x18 7908]

/-- Trapdoor-group offset of output doubleword `m < 16` in copy variant `v` (rotation by `v`). -/
def variantOffset (v m : Nat) : Nat := 32*((v+m/4+1)%5)+8*(m%4)

/-- `n` load/store pairs of copy variant `v`: source `x30 + variantOffset v m`, target `x21 + 8m`. -/
def variantPairs (v n : Nat) : List Instr :=
  (List.range n).flatMap fun m =>
    [.LD .x31 .x30 (BitVec.ofNat 12 (variantOffset v m)), .SD .x21 .x31 (BitVec.ofNat 12 (8*m))]

def variantCode (v : Nat) : List Instr :=
  variantPairs v 16 ++ [.ADDI .x21 .x21 128, .JALR .x0 .x1 0] ++ List.replicate 30 (.ADDI .x0 .x0 0)

/-- Output offset (from the record start) of doubleword `m` of level `k`. -/
def storeOffset (k m : Nat) : Nat := 16+128*k+8*m

/-- `n` load/store pairs of the level-`k` copy variant `v`: source `x30 + variantOffset v m`,
target `x21 + storeOffset k m`. -/
def levelPairs (k v n : Nat) : List Instr :=
  (List.range n).flatMap fun m =>
    [.LD .x31 .x30 (BitVec.ofNat 12 (variantOffset v m)), .SD .x21 .x31 (BitVec.ofNat 12 (storeOffset k m))]

/-- Word where the level after `k` starts (word 104, the loop latch, after level 6). -/
def nextStart (k : Nat) : Nat := 41+9*(k+1)

/-- The level-6 variants advance `x21` to the next record. -/
def levelAdvance (k : Nat) : List Instr := if k = 6 then [.ADDI .x21 .x21 912] else []

/-- Backward `jal` from word `here` to word `target < here`. -/
def backJump (here target : Nat) : BitVec 21 := BitVec.ofNat 21 (2^21+4*target-4*here)

def levelExitWord (k v : Nat) : Nat := levelVariantStart k v+32+(levelAdvance k).length

def levelVariantCode (k v : Nat) : List Instr :=
  levelPairs k v 16 ++ levelAdvance k ++ [.JAL .x0 (backJump (levelExitWord k v) (nextStart k))] ++
    List.replicate (31-(levelAdvance k).length) (.ADDI .x0 .x0 0)

/-! ### Paired levels `(2p, 2p+1)`, `p = 0, 1, 2`

The head divides the node `x6` by 25 in place (`x25 = x6 % 25`), computes `x11 = base (2p+1) + 368 Q`
and `x30 = base (2p) + 1840 Q`, and enters variant `x25 = 5 r₁ + r₀` of pair `p`. The variant copies the
level-`2p` siblings of child `r₀` from the group at `x30 + 368 r₁` and the level-`2p+1` siblings of child
`r₁` from `x11`, then jumps to the next level head. -/

/-- The pure part of a pair head with level-base registers `bk`, `bk1` and variant-table register `t`. -/
def prepWith (bk bk1 t : Reg) : List Instr :=
  [.REMU .x25 .x6 .x26, .DIVU .x6 .x6 .x26, .MUL .x10 .x6 .x23, .ADD .x11 .x10 bk1,
   .SLLI .x7 .x10 2, .ADD .x7 .x7 .x10, .ADD .x30 .x7 bk, .SLLI .x7 .x25 9, .ADD .x7 .x7 t]

def pairPrep (p : Nat) : List Instr := prepWith (baseReg (2*p)) (baseReg (2*p+1)) (tableReg p)

def pairHead (p : Nat) : List Instr := pairPrep p ++ [.JALR .x0 .x7 0]

def pairBlock (p : Nat) : List Instr := pairHead p ++ List.replicate 8 (.ADDI .x0 .x0 0)

/-! ### The level triple `(4, 5, 6)`

The head divides the level-4 node `x6` by 125 into `x24` (`x25 = x6 % 125`), computes
`x27 = base 6 + 368 Q`, `x11 = base 5 + 1840 Q` and `x30 = base 4 + 9200 Q`, and enters variant
`v = x25` at word `14336 + 128 v`. The variant adds `4096 (tripleHi v)` to `x30`, copies the level-4
siblings of child `v % 5` from `x30 + 368 (v / 5)` (negative 12-bit offsets for `hi > 0`), the level-5
siblings of child `v / 5 % 5` from `x11 + 368 (v / 25)` and the level-6 siblings of child `v / 25` from
`x27`, advances `x21` to the next record and jumps to the latch. -/

def triplePrep : List Instr :=
  [.REMU .x25 .x6 .x28, .DIVU .x24 .x6 .x28, .MUL .x10 .x24 .x23, .ADD .x27 .x10 (baseReg 6),
   .SLLI .x7 .x10 2, .ADD .x10 .x7 .x10, .ADD .x11 .x10 (baseReg 5),
   .SLLI .x7 .x10 2, .ADD .x7 .x7 .x10, .ADD .x30 .x7 (baseReg 4), .SLLI .x7 .x25 9, .ADD .x7 .x7 .x20]

def tripleHead : List Instr := triplePrep ++ [.JALR .x0 .x7 0]

def tripleBlock : List Instr := tripleHead ++ List.replicate 14 (.ADDI .x0 .x0 0)

/-- Words 41-103: the two pair heads (18 words each) and the triple head. -/
def levelsCode : List Instr := (List.range 2).flatMap pairBlock ++ tripleBlock

/-- Page added to the level-4 group pointer by triple variant `v`. -/
def tripleHi (v : Nat) : Nat := if 368*(v/5) ≤ 1895 then 0 else if 368*(v/5) ≤ 5991 then 1 else 2

/-- `n` load/store pairs from `reg + off + variantOffset v m` to `x21 + storeOffset k m`. -/
def genPairs (reg : Reg) (off k v n : Nat) : List Instr :=
  (List.range n).flatMap fun m =>
    [.LD .x31 reg (BitVec.ofNat 12 (off+variantOffset v m)), .SD .x21 .x31 (BitVec.ofNat 12 (storeOffset k m))]

/-- First word of variant `v < 25` of pair `p` (128-word stride, 4096 words per pair). -/
def pairStart (p v : Nat) : Nat := 6144+4096*p+128*v

def pairExitWord (p v : Nat) : Nat := pairStart p v+64


/-- The head of the next level group, inlined at the end of every pair variant. -/
def nextPrep (p : Nat) : List Instr := if p = 0 then pairPrep 1 else triplePrep

def pairVariantCode (p v : Nat) : List Instr :=
  genPairs .x30 (368*(v/5)) (2*p) (v%5) 16 ++ genPairs .x11 0 (2*p+1) (v/5) 16 ++
    nextPrep p ++ [.JALR .x0 .x7 0] ++ List.replicate (63-(nextPrep p).length) (.ADDI .x0 .x0 0)

def tripleStart (v : Nat) : Nat := 14336+128*v

def tripleExitWord (v : Nat) : Nat := tripleStart v+99

def tripleVariantCode (v : Nat) : List Instr :=
  [.LUI .x10 (BitVec.ofNat 20 (tripleHi v)), .ADD .x30 .x30 .x10] ++
    genPairs .x30 (368*(v/5)+8192-4096*tripleHi v) 4 (v%5) 16 ++
    genPairs .x11 (368*(v/25)) 5 (v/5%5) 16 ++ genPairs .x27 0 6 (v/25) 16 ++
    [.ADDI .x21 .x21 912, .JAL .x0 (backJump (tripleExitWord v) 104)] ++ List.replicate 28 (.ADDI .x0 .x0 0)

def pairsList : List Instr :=
  (List.range 2).flatMap (fun p =>
    (List.range 25).flatMap (pairVariantCode p) ++ List.replicate 896 (.ADDI .x0 .x0 0)) ++
  (List.range 125).flatMap tripleVariantCode

def exitCode : List Instr := [.SUB .x11 .x21 .x15, .ADDI .x5 .x0 1, .ADDI .x10 .x0 0, .ECALL]

/-- Word 106: jump from the record latch to the table copy at word 527. -/
def footerJump : Instr := .JAL .x0 1684

/-- The first `n` load/store pairs of a table group. -/
def groupPairs (n : Nat) : List Instr :=
  (List.range n).flatMap fun m => [.LD .x31 .x30 (BitVec.ofNat 12 (8*m)), .SD .x21 .x31 (BitVec.ofNat 12 (8*m))]

/-- One group of the table copy: 20 doublewords from `x30` to `x21`, then the next group. -/
def groupCode : List Instr :=
  groupPairs 20 ++
    [.ADDI .x30 .x30 368, .ADDI .x21 .x21 160]

/-- Doublewords copied by the last group. The root group has two transmitted slots. -/
def lastWords (level : Nat) : Nat := if level = 10 then 8 else 20

def lastAdvance (level : Nat) : Nat := 8 * lastWords level

/-- The last group does not advance the source pointer. -/
def lastGroupCode (level : Nat) : List Instr :=
  groupPairs (lastWords level) ++ [.ADDI .x21 .x21 (BitVec.ofNat 12 (lastAdvance level))]

/-- Level `k` of the table copy: initialize the source pointer and copy its groups. -/
def tableLevelCode (k : Nat) : List Instr :=
  ([.LUI .x11 (BitVec.ofNat 20 (groupPage k)), .ADD .x30 .x11 .x9] ++
    (List.replicate (pentaCount (k+1) - 1) groupCode).flatten) ++ lastGroupCode k

/-- Footer setup (words 527-533): `x10` = first level-7 group, `x12` = scratch `x21 + 8192`,
`x11 = 200`, `x13 = 1` (forward permutation), `x5 = 0`. -/
def footHead : List Instr :=
  [.LUI .x11 (BitVec.ofNat 20 (groupPage 7)), .ADD .x10 .x11 .x9, .LUI .x12 2, .ADD .x12 .x12 .x21,
   .ADDI .x11 .x0 200, .ADDI .x13 .x0 1, .ADDI .x5 .x0 0]

/-- One forward call: permute the 200 bytes at the group into scratch, advance both pointers. -/
def fwdBlock : List Instr := [.ECALL, .ADDI .x10 .x10 368, .ADDI .x12 .x12 200]

/-- Switch to the inverse permutation, read from scratch and write to the proof cursor. -/
def footMid : List Instr := [.ADDI .x30 .x10 0, .ADDI .x13 .x0 2, .LUI .x10 2, .ADD .x10 .x10 .x21, .ADDI .x12 .x21 0]

/-- One inverse call: invert a scratch block into the proof, advance both pointers. -/
def invBlock : List Instr := [.ECALL, .ADDI .x10 .x10 200, .ADDI .x12 .x12 160]

/-- The last table group: 20 doublewords from `x30` to `x12`. -/
def lastCode : List Instr :=
  (List.range 20).flatMap fun m => [.LD .x31 .x30 (BitVec.ofNat 12 (8*m)), .SD .x12 .x31 (BitVec.ofNat 12 (8*m))]

def footExit : List Instr := [.ADDI .x12 .x12 160, .SUB .x11 .x12 .x15, .ADDI .x5 .x0 1, .ADDI .x10 .x0 0, .ECALL]

/-- Words 527-2820: the level-7 table copied through 43 forward and 43 inverse permutation calls
(words 534-662 and 667-795), the exit at words 796-799, then padding. The checker recomputes
levels 8 to 10. -/
def footerCode : List Instr :=
  footHead ++ (List.replicate 42 fwdBlock).flatten ++ footMid ++ (List.replicate 42 invBlock).flatten ++
    lastCode ++ footExit ++ List.replicate 1985 (.ADDI .x0 .x0 0)

def prefixCode : List Instr :=
  [.ADDI .x8 .x13 0, .ADDI .x9 .x12 0, .ADDI .x18 .x16 0, .LUI .x22 442369, .ADD .x22 .x9 .x22,
   .ADDI .x19 .x0 5, .ADDI .x23 .x0 368, .LUI .x26 1, .ADDI .x26 .x26 636,
   .ADDI .x10 .x0 1024, .ADDI .x12 .x0 1536, .ADDI .x11 .x0 200, .ADDI .x13 .x0 1,
   .ADDI .x5 .x0 0, .ADDI .x14 .x8 0, .SLLI .x17 .x18 3, .ADD .x17 .x17 .x8, .LUI .x24 1,
   .ADDI .x27 .x24 (-1), .ADDI .x29 .x0 11,
   .LD .x31 .x22 8, .SD .x10 .x31 8, .LD .x31 .x22 16, .SD .x10 .x31 16,
   .LD .x31 .x22 24, .SD .x10 .x31 24,
   .LD .x6 .x14 0, .REMU .x28 .x6 .x27, .REMU .x28 .x28 .x29, .SUB .x7 .x6 .x28,
   .SLLI .x7 .x7 8, .ADD .x7 .x7 .x24, .SD .x10 .x7 0, .ECALL,
   .SLLI .x7 .x28 4, .BNE .x28 .x0 8, .ADDI .x7 .x0 200,
   .ADD .x7 .x7 .x12, .SLLI .x30 .x6 4, .ADD .x30 .x30 .x22,
   .LD .x31 .x7 (-16), .SD .x30 .x31 0, .LD .x31 .x7 (-8), .SD .x30 .x31 8,
   .ADDI .x14 .x14 8, .BNE .x14 .x17 8116, .JAL .x0 2095096, .ADDI .x0 .x0 0]

/-! ### The full-group record writer (words 11-105)

Each record is the salt and, for levels `k = 0 … 6`, the five slots of the record's level-`k` group.
The writer copies each group through the permutation: seven forward calls `P(group k)` into a
1,400-byte scratch area, then seven inverse calls from the scratch into the record. -/

/-- Register holding `trapdoor + pentaGroupBase k + 40` during the record loop. -/
def recBase : Nat → Reg
  | 0 => .x2
  | 1 => .x3
  | 2 => .x4
  | 3 => .x14
  | 4 => .x16
  | 5 => .x17
  | _ => .x20

/-- Words 11-20: scratch pointer `x12 = proof + 1136 k + 32768`, syscall registers, end pointer. -/
def recSetup : List Instr :=
  [.ADDI .x7 .x0 1136, .MUL .x7 .x18 .x7, .ADD .x7 .x7 .x15, .LUI .x12 8, .ADD .x12 .x12 .x7,
   .ADDI .x11 .x0 200, .ADDI .x13 .x0 1, .ADDI .x5 .x0 0, .SLLI .x18 .x18 3, .ADD .x18 .x18 .x8]

/-- Words 21-34: the seven group bases. -/
def recBases : List Instr :=
  (List.range 7).flatMap fun k =>
    [.LUI (recBase k) (BitVec.ofNat 20 (groupPage k)), .ADD (recBase k) (recBase k) .x9]

/-- Words 35-41: the index and the salt. -/
def recSalt : List Instr :=
  [.LD .x6 .x8 0, .SLLI .x7 .x6 4, .ADD .x7 .x22 .x7, .LD .x31 .x7 0, .SD .x21 .x31 0,
   .LD .x31 .x7 8, .SD .x21 .x31 8]

/-- Forward block `k`: the level-`k` group address, `P(group)` into scratch. -/
def recFwd (k : Nat) : List Instr :=
  [.DIVU .x6 .x6 .x19, .MUL .x10 .x6 .x23, .ADD .x10 .x10 (recBase k), .ECALL, .ADDI .x12 .x12 200]

def recMid : List Instr := [.ADDI .x13 .x0 2, .ADDI .x10 .x12 (-1400), .ADDI .x12 .x21 16]

def recInv : List Instr := [.ECALL, .ADDI .x10 .x10 200, .ADDI .x12 .x12 160]

def recBack : List Instr := [.ADDI .x13 .x0 1, .ADDI .x21 .x12 0, .ADDI .x12 .x10 (-1400)]

def recLatch : List Instr := [.ADDI .x8 .x8 8, .BNE .x8 .x18 7912]

def recCode : List Instr :=
  recSetup ++ recBases ++ recSalt ++ (List.range 7).flatMap recFwd ++ recMid ++
    (List.replicate 7 recInv).flatten ++ recBack ++ recLatch

def program : List Instr :=
  -- Words 0-10 setup, 11-105 the full-group record writer, 106 the table jump, 41 dead words
  -- (107-147), the empty-opening exit (148-151), seven unreachable words and the old (now unused) copy
  -- variants keep every later address. After the table copy (527-2820), padding and dead code.
  setupCode ++ recCode ++
    [footerJump] ++ List.replicate 41 (.ADDI .x0 .x0 0) ++ exitCode ++ List.replicate 7 (.ADDI .x0 .x0 0) ++
    (List.range 5).flatMap variantCode ++ prefixCode ++ footerCode ++
    (List.replicate 251 (.ADDI .x0 .x0 0) ++
      (List.range 7).flatMap (fun k => (List.range 5).flatMap (levelVariantCode k))) ++
    List.replicate 832 (.ADDI .x0 .x0 0) ++ pairsList

theorem program_length : program.length = 30336 := by decide +kernel

set_option maxHeartbeats 4000000 in
theorem program_decoded : openingImage.code.map QOpening.decodeBase = program.map some := by
  decide +kernel

theorem image_length : openingImage.code.length = 30336 := by decide +kernel

theorem program_decode (index : Nat) :
    (openingImage.code[index]?).bind QOpening.decodeBase = program[index]? := by
  have h := congrArg (fun l => l[index]?) program_decoded
  simp only [List.getElem?_map] at h
  cases hc : openingImage.code[index]? <;> cases hp : program[index]? <;> simp_all

theorem fetch_program (state : MachineState) (index : Nat) (instruction : Instr)
    (code : program[index]? = some instruction)
    (pc : state.pc = BitVec.ofNat 64 (4096+4*index)) :
    fetch openingImage state = some (.base instruction) := by
  have bounded : index < 30336 := by
    rw [← program_length]
    exact (List.getElem?_eq_some_iff.mp code).1
  have decoded := (program_decode index).trans code
  have current : state.pc.toNat = 4096+4*index := by
    rw [pc, BitVec.toNat_ofNat, Nat.mod_eq_of_lt]
    omega
  rw [fetch, current, ite_eq_left (by omega), show (4096+4*index-4096)/4 = index by omega]
  cases hcode : openingImage.code[index]? with
  | none => simp [hcode] at decoded
  | some w =>
    simp [hcode, QOpening.decodeBase] at decoded
    cases dec : decodeInstruction w with
    | none => simp [dec] at decoded
    | some result =>
      cases result with
      | base inst =>
        simp [dec] at decoded
        simpa [decoded] using dec
      | word op rd rs₁ rs₂ => simp [dec] at decoded
      | sraiw rd rs sh => simp [dec] at decoded

end TwoPermutationPrototype.QuadOpening
