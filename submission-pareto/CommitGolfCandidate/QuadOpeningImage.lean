/-- `lui` page of the level-`k` group base plus 40. -/
def groupPage (k : Nat) : Nat := (pentaGroupBase k + 40) / 4096

/-- `n` doubleword load/store pairs from `x7` to `x21`. -/
def pairCode (n : Nat) : List Instr :=
  (List.range n).flatMap fun w => [.LD .x31 .x7 (BitVec.ofNat 12 (8*w)), .SD .x21 .x31 (BitVec.ofNat 12 (8*w))]

def setupCode : List Instr :=
  [.ADDI .x21 .x15 0, .BEQ .x16 .x0 588, .JAL .x0 1908, .ADDI .x9 .x12 0,
   .ADDI .x18 .x16 0, .LUI .x22 442369, .ADD .x22 .x9 .x22, .ADDI .x19 .x0 5, .ADDI .x23 .x0 368,
   .LUI .x26 1, .ADDI .x26 .x26 636]

def saltHead : List Instr := [.LD .x6 .x8 0, .SLLI .x7 .x6 4, .ADD .x7 .x22 .x7]

/-- Register holding the address of the level-`k` copy-variant table (`x7 = 256 r + tableReg k`). -/
def tableReg : Nat → Reg
  | 0 => .x5
  | 1 => .x17
  | 2 => .x20
  | 3 => .x26
  | 4 => .x27
  | 5 => .x28
  | _ => .x29

/-- First word of the level-`k` copy variant `v` (64-word stride, 320 words per level). -/
def levelVariantStart (k v : Nat) : Nat := 3072+320*k+64*v

/-- Address of the level-`k` variant table. -/
def tableStart (k : Nat) : Nat := 4096+4*levelVariantStart k 0

/-- Words 25-31: the seven variant-table addresses (`16384 + 1280 k`). -/
def tableCode : List Instr :=
  [.LUI .x5 4, .ADDI .x17 .x5 1280, .ADDI .x20 .x17 1280,
   .ADDI .x26 .x20 1280, .ADDI .x27 .x26 1280, .ADDI .x28 .x27 1280, .ADDI .x29 .x28 1280]

/-- Words 32-33: `x18 := indices + 8 · count`, the end of the index buffer. -/
def endCode : List Instr := [.SLLI .x18 .x18 3, .ADD .x18 .x18 .x8]

/-- The record salt: two doublewords at offsets 0 and 8 of the record; `x21` stays at the record. -/
def saltCode : List Instr := saltHead ++ pairCode 2

/-- Level `k` reads node `index / 5^k` from `nodeReg k` and writes its parent into `nodeReg (k+1)`. -/
def nodeReg (j : Nat) : Reg := if j % 2 = 0 then .x6 else .x24

/-- Register holding `trapdoor + pentaGroupBase k + 40` for record levels `k = 0 … 6`. -/
def baseReg : Nat → Reg
  | 0 => .x2
  | 1 => .x3
  | 2 => .x4
  | 3 => .x12
  | 4 => .x13
  | 5 => .x14
  | _ => .x16

/-- Words 11-24: load the seven level group bases once, before the first record. -/
def baseCode : List Instr :=
  (List.range 7).flatMap fun k =>
    [.LUI (baseReg k) (BitVec.ofNat 20 (groupPage k)), .ADD (baseReg k) (baseReg k) .x9]

/-- Head of a level reading node register `a` and writing the parent into `b`. -/
def headWith (a b base : Reg) : List Instr :=
  [.DIVU b a .x19, .SLLI .x25 b 2, .ADD .x25 .x25 b, .SUB .x25 a .x25, .MUL .x10 b .x23, .ADD .x30 .x10 base]

def levelHead (k : Nat) : List Instr := headWith (nodeReg k) (nodeReg (k+1)) (baseReg k)

def dispatchCode (k : Nat) : List Instr := [.SLLI .x7 .x25 8, .ADD .x7 .x7 (tableReg k)]

def levelCode (k : Nat) : List Instr :=
  levelHead k ++ dispatchCode k ++ [.JALR .x0 .x7 0]

def tailCode : List Instr := [.ADDI .x8 .x8 8, .BNE .x8 .x18 7908]

/-- Trapdoor-group offset of output doubleword `m < 16` in copy variant `v` (rotation by `v`). -/
def variantOffset (v m : Nat) : Nat := 32*((v+m/4+1)%5)+8*(m%4)

/-- `n` load/store pairs of copy variant `v`: source `x30 + variantOffset v m`, target `x21 + 8m`. -/
def variantPairs (v n : Nat) : List Instr :=
  (List.range n).flatMap fun m =>
    [.LD .x31 .x30 (BitVec.ofNat 12 (variantOffset v m)), .SD .x21 .x31 (BitVec.ofNat 12 (8*m))]

def variantCode (v : Nat) : List Instr :=
  variantPairs v 16 ++ [.ADDI .x21 .x21 128, .JALR .x0 .x1 0] ++ List.replicate 30 (.ADDI .x0 .x0 0)

/-- Output offset (from the record start) of doubleword `m` of level `k`. -/
def storeOffset (k m : Nat) : Nat := 16+128*k+8*m

/-- `n` load/store pairs of the level-`k` copy variant `v`: source `x30 + variantOffset v m`,
target `x21 + storeOffset k m`. -/
def levelPairs (k v n : Nat) : List Instr :=
  (List.range n).flatMap fun m =>
    [.LD .x31 .x30 (BitVec.ofNat 12 (variantOffset v m)), .SD .x21 .x31 (BitVec.ofNat 12 (storeOffset k m))]

/-- Word where the level after `k` starts (word 104, the loop latch, after level 6). -/
def nextStart (k : Nat) : Nat := 41+9*(k+1)

/-- The level-6 variants advance `x21` to the next record. -/
def levelAdvance (k : Nat) : List Instr := if k = 6 then [.ADDI .x21 .x21 912] else []

/-- Backward `jal` from word `here` to word `target < here`. -/
def backJump (here target : Nat) : BitVec 21 := BitVec.ofNat 21 (2^21+4*target-4*here)

def levelExitWord (k v : Nat) : Nat := levelVariantStart k v+32+(levelAdvance k).length

def levelVariantCode (k v : Nat) : List Instr :=
  levelPairs k v 16 ++ levelAdvance k ++ [.JAL .x0 (backJump (levelExitWord k v) (nextStart k))] ++
    List.replicate (31-(levelAdvance k).length) (.ADDI .x0 .x0 0)

def exitCode : List Instr := [.SUB .x11 .x21 .x15, .ADDI .x5 .x0 1, .ADDI .x10 .x0 0, .ECALL]

/-- Word 106: jump from the record latch to the table copy at word 527. -/
def footerJump : Instr := .JAL .x0 1684

/-- The first `n` load/store pairs of a table group. -/
def groupPairs (n : Nat) : List Instr :=
  (List.range n).flatMap fun m => [.LD .x31 .x30 (BitVec.ofNat 12 (8*m)), .SD .x21 .x31 (BitVec.ofNat 12 (8*m))]

/-- One group of the table copy: 20 doublewords from `x30` to `x21`, then the next group. -/
def groupCode : List Instr :=
  groupPairs 20 ++
    [.ADDI .x30 .x30 368, .ADDI .x21 .x21 160]

/-- Doublewords copied by the last group. The root group has two transmitted slots. -/
def lastWords (level : Nat) : Nat := if level = 10 then 8 else 20

def lastAdvance (level : Nat) : Nat := 8 * lastWords level

/-- The last group does not advance the source pointer. -/
def lastGroupCode (level : Nat) : List Instr :=
  groupPairs (lastWords level) ++ [.ADDI .x21 .x21 (BitVec.ofNat 12 (lastAdvance level))]

/-- Level `k` of the table copy: initialize the source pointer and copy its groups. -/
def tableLevelCode (k : Nat) : List Instr :=
  ([.LUI .x11 (BitVec.ofNat 20 (groupPage k)), .ADD .x30 .x11 .x9] ++
    (List.replicate (pentaCount (k+1) - 1) groupCode).flatten) ++ lastGroupCode k

/-- Words 527-2820: the level-7 table (43 groups), the exit at words 2334-2337, then padding. The
checker recomputes levels 8 to 10. -/
def footerCode : List Instr :=
  tableLevelCode 7 ++ exitCode ++ List.replicate 483 (.ADDI .x0 .x0 0)

def prefixCode : List Instr :=
  [.ADDI .x8 .x13 0, .ADDI .x9 .x12 0, .ADDI .x18 .x16 0, .LUI .x22 442369, .ADD .x22 .x9 .x22,
   .ADDI .x19 .x0 5, .ADDI .x23 .x0 368, .LUI .x26 1, .ADDI .x26 .x26 636,
   .ADDI .x10 .x0 1024, .ADDI .x12 .x0 1536, .ADDI .x11 .x0 200, .ADDI .x13 .x0 1,
   .ADDI .x5 .x0 0, .ADDI .x14 .x8 0, .ADDI .x17 .x18 0, .LUI .x24 1,
   .ADDI .x27 .x24 (-1), .ADDI .x29 .x0 11,
   .LD .x31 .x22 8, .SD .x10 .x31 8, .LD .x31 .x22 16, .SD .x10 .x31 16,
   .LD .x31 .x22 24, .SD .x10 .x31 24,
   .LD .x6 .x14 0, .REMU .x28 .x6 .x27, .REMU .x28 .x28 .x29, .SUB .x7 .x6 .x28,
   .SLLI .x7 .x7 8, .ADD .x7 .x7 .x24, .SD .x10 .x7 0, .ECALL,
   .ADDI .x7 .x28 (-1), .SLLI .x7 .x7 4, .BNE .x28 .x0 8, .ADDI .x7 .x0 184,
   .ADD .x7 .x7 .x12, .SLLI .x30 .x6 4, .ADD .x30 .x30 .x22,
   .LD .x31 .x7 0, .SD .x30 .x31 0, .LD .x31 .x7 8, .SD .x30 .x31 8,
   .ADDI .x14 .x14 8, .ADDI .x17 .x17 (-1), .BNE .x17 .x0 8108, .JAL .x0 2095092]

def program : List Instr :=
  -- Bases (words 11-24), variant tables (25-31), end pointer (32-33), salt (34-40), levels 0-6
  -- (words 41-103), latch (104-105), table jump (106), 41 dead words (107-147), the empty-opening
  -- exit (148-151), seven unreachable words and the old (now unused) copy variants keep every later
  -- address. After the table copy (527-2820), 251 padding words and the 35 level-specialized copy
  -- variants (words 3072-5311).
  setupCode ++ baseCode ++ tableCode ++ endCode ++ saltCode ++ (List.range 7).flatMap levelCode ++ tailCode ++
    [footerJump] ++ List.replicate 41 (.ADDI .x0 .x0 0) ++ exitCode ++ List.replicate 7 (.ADDI .x0 .x0 0) ++
    (List.range 5).flatMap variantCode ++ prefixCode ++ footerCode ++
    (List.replicate 251 (.ADDI .x0 .x0 0) ++
      (List.range 7).flatMap (fun k => (List.range 5).flatMap (levelVariantCode k)))

theorem program_length : program.length = 5312 := by decide +kernel

set_option maxHeartbeats 4000000 in
theorem program_decoded : openingImage.code.map QOpening.decodeBase = program.map some := by
  decide +kernel

theorem image_length : openingImage.code.length = 5312 := by decide +kernel

theorem program_decode (index : Nat) :
    (openingImage.code[index]?).bind QOpening.decodeBase = program[index]? := by
  have h := congrArg (fun l => l[index]?) program_decoded
  simp only [List.getElem?_map] at h
  cases hc : openingImage.code[index]? <;> cases hp : program[index]? <;> simp_all

theorem fetch_program (state : MachineState) (index : Nat) (instruction : Instr)
    (code : program[index]? = some instruction)
    (pc : state.pc = BitVec.ofNat 64 (4096+4*index)) :
    fetch openingImage state = some (.base instruction) := by
  have bounded : index < 5312 := by
    rw [← program_length]
    exact (List.getElem?_eq_some_iff.mp code).1
  have decoded := (program_decode index).trans code
  have current : state.pc.toNat = 4096+4*index := by
    rw [pc, BitVec.toNat_ofNat, Nat.mod_eq_of_lt]
    omega
  rw [fetch, current, ite_eq_left (by omega), show (4096+4*index-4096)/4 = index by omega]
  cases hcode : openingImage.code[index]? with
  | none => simp [hcode] at decoded
  | some w =>
    simp [hcode, QOpening.decodeBase] at decoded
    cases dec : decodeInstruction w with
    | none => simp [dec] at decoded
    | some result =>
      cases result with
      | base inst =>
        simp [dec] at decoded
        simpa [decoded] using dec
      | word op rd rs₁ rs₂ => simp [dec] at decoded
      | sraiw rd rs sh => simp [dec] at decoded

end TwoPermutationPrototype.QuadOpening
