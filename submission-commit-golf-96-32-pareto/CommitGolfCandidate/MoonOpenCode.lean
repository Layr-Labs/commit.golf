  unfold openInstr
  rw [hq2, hm2]
  generalize hqv : k / 64 = q at hq hdiv ⊢
  interval_cases q
  · have h := decode_c0 ⟨k % 64, by omega⟩
    change _ = some (openList_c0.getD (k % 64) (.base .EBREAK))
    simpa only [show 0 + k % 64 = k by omega] using h
