private theorem decode_block_0 (k : Nat) (hk : k < 512) :
    decodeInstruction (openCode_0_0.get 32 ⟨k, hk⟩) =
      some (openInstr (0 + k)) := by
  have hq : k / 64 < 8 := by omega
  have hdiv : 64 * (k / 64) + k % 64 = k := Nat.div_add_mod k 64
