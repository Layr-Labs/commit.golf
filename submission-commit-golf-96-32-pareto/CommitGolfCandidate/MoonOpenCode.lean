/-! ### Slice Matching Helper for Modular Symbolic Execution -/

def CodeAt (pc : Nat) (code : List Instruction) : Prop :=
  pc + code.length ≤ OPEN_CODE_LEN ∧ ∀ k (hk : k < code.length), openInstr (pc + k) = code[k]

theorem CodeAt.left {pc : Nat} {a b : List Instruction} (h : CodeAt pc (a ++ b)) : CodeAt pc a :=
  ⟨by have := h.1; simp only [List.length_append] at this; omega,
   fun k hk => by
     have hk' : k < (a ++ b).length := by simp only [List.length_append]; omega
     simpa only [List.getElem_append_left hk] using h.2 k hk'⟩

theorem CodeAt.right {pc : Nat} {a b : List Instruction} (h : CodeAt pc (a ++ b)) :
    CodeAt (pc + a.length) b :=
  ⟨by have := h.1; simp only [List.length_append] at this; omega,
   fun k hk => by
     have hk' : a.length + k < (a ++ b).length := by simp only [List.length_append]; omega
     have h2 := h.2 (a.length + k) hk'
     rw [← Nat.add_assoc] at h2
     simpa only [List.getElem_append_right (Nat.le_add_right a.length k), Nat.add_sub_cancel_left] using h2⟩

theorem codeAt_of_list_eq (pc : Nat) (code : List Instruction)
    (hbd : pc + code.length ≤ OPEN_CODE_LEN)
    (h : (List.range code.length).map (fun k => openInstr (pc + k)) = code) :
    CodeAt pc code := by
  refine ⟨hbd, fun k hk => ?_⟩
  have hq := congrArg (fun l => l[k]?) h
  simp only [List.getElem?_map, List.getElem?_range hk, Option.map_some,
    List.getElem?_eq_getElem hk, Option.some.injEq] at hq
  exact hq

