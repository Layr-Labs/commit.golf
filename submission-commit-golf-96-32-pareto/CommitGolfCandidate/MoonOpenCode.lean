/-- Fast opening image pairing `openCode` with unchanged `MoonArtifact.openingData`. -/
def openImage : Image :=
  ⟨ArtifactEncoding.decode 32 openCode, ArtifactEncoding.decode 8 MoonArtifact.openingData⟩

/-- Submission carrying `openImage` for `.opening` and existing images for `.commit`/`.check`. -/
def openSub : CommitGolf.Submission :=
  { submission with image := fun
      | .opening => openImage
      | p => submission.image p }

theorem openCode_eq_artifact : openCode = MoonArtifact.openingCode := by
  rfl

theorem openImage_eq_submission : openImage = submission.image .opening := by
  unfold openImage submission MoonArtifact.submission
  simp only [openCode_eq_artifact]

theorem openSub_eq_submission : openSub = submission := by
  have himg : (fun
      | Program.opening => openImage
      | p => submission.image p) = submission.image := by
    funext p
    cases p with
    | commit => rfl
    | opening => exact openImage_eq_submission
    | check => rfl
  unfold openSub
  exact congrArg (fun img => { submission with image := img }) himg

theorem openImage_dataBase : dataBase openImage = 68719475936 := by
  simp only [openImage, dataBase, ArtifactEncoding.length_decode, MEMORY_BYTES]
  decide

theorem openImage_valid : openImage.Valid (openSub.layout.buffers openSub.sizes) := by
  refine ⟨?_, ?_, ?_⟩
  · simp only [openImage, Image.byteSize, ArtifactEncoding.length_decode, MAX_PROGRAM_BYTES]
    decide
  · intro b hb
    rw [openImage_dataBase]
    simp only [openSub, submission, MoonArtifact.submission, Layout.buffers, LENGTH, LOG_LENGTH,
      LEAF_SIZE, DIGEST_BYTES, List.mem_cons, List.not_mem_nil, or_false] at hb
    rcases hb with rfl | rfl | rfl | rfl | rfl | rfl <;> decide
  · simp only [openSub, submission, MoonArtifact.submission, Layout.buffers, LENGTH, LOG_LENGTH,
      LEAF_SIZE, DIGEST_BYTES]
    decide

theorem openSub_initialState_eq (inp : Input submission.sizes .opening) :
    openSub.initialState .opening inp = submission.initialState .opening inp := by
  unfold Submission.initialState
  have hdb : dataBase (openSub.image .opening) = dataBase (submission.image .opening) := by
    change dataBase openImage = _; rw [openImage_dataBase, opening_dataBase]
  have hdata : (openSub.image .opening).data = (submission.image .opening).data := rfl
  have hbuf : openSub.inputBuffers .opening inp = submission.inputBuffers .opening inp := rfl
  have hlay : openSub.layout = submission.layout := rfl
  have hpl : inputProofLength openSub.sizes .opening inp = inputProofLength submission.sizes .opening inp := rfl
  simp only [hdb, hdata, hbuf, hlay, hpl]
  rfl

