import CommitGolf

/-! # The challenge

The trusted track registry selects the certificate; submissions cannot select it.
The verifier fills `{{proofBytes}}` and `{{checkCalls}}` from the submission's `claim.json`.
`comparator` checks that the submission's `Solution` module proves this exact `certificate`
statement about its own `submission`, replays every declaration through Lean's kernel, and
admits only the axioms `propext`, `Quot.sound` and `Classical.choice`. -/

namespace CommitGolf.Challenge

noncomputable def submission : CommitGolf.Scheme := sorry

theorem certificate : CommitGolf.{{certificate}} submission {{proofBytes}} {{checkCalls}} := sorry

end CommitGolf.Challenge
