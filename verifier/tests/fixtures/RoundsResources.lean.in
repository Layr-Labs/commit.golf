import CommitGolfDepth.Rounds
import CommitGolf.Artifact

/-! Resource-only regression contract. This is not a production security certificate. -/
namespace CommitGolf.Challenge
open OracleComp OracleSpec CommitGolfDepth.Rounds CommitGolfDepth.Rounds.RoundMachine

noncomputable def submission : CommitGolfDepth.Rounds.Submission := sorry

theorem submission_matches_artifact : submission = Artifact.depthSubmission := sorry

theorem admission : submission.core.Admission := sorry

theorem resource_fixture (oracle : Oracle) :
    Pr{let result ← oracle.run (submission.run .commit (fun _ => 0))}[
      result.1.result.exit = .success ∧ result.1.result.cycles ≤ {{work}} ∧
      result.1.oracleRounds ≤ {{depth}} ∧ result.1.result.oracleCalls = 2 ∧ result.2 = 2 ∧
      result.1.result.state.getByte 543 = (oracle.compression 0).extractLsb' 248 8 ∧
      result.1.result.state.getByte 575 = (oracle.compression 0).extractLsb' 248 8] = 1 := sorry

end CommitGolf.Challenge
