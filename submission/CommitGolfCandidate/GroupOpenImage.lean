/-- Number of words in the opener image. -/
abbrev openingWords : Nat := 12320

/-! T238 writer blocks appended after the prefix pass (all writer code addresses live here). -/
/-- Retained A1 halfword-copy stub; whole-width level 1 now returns directly to word 220. -/
def a1Start : Nat := 813
/-- F: the record fold (34 words) and `jal <640>`. -/
def foldStart : Nat := 817
/-- WI: `addi x6,x0,1; addi x30,x0,7; jal <661>`. -/
def wiStart : Nat := 852
/-- WK: `beq x30,x0,<WS>; addi x30,x30,-1; sh x31,28(x21); jal <700>`. -/
def wkStart : Nat := 697
/-- WS: `addi x30,x0,7`, the fold (34 words), `addi x21,x21,-2; jal <700>`. -/
def wsStart : Nat := 859

theorem packed_fetch_base (state : MachineState) (index : Nat) (instruction : Instr)
    (bounded : index < 896) (pc : state.pc = BitVec.ofNat 64 (4096+4*index))
    (decoded : (openingImage.code[index]?).bind Opening.decodeBase = some instruction) :
    fetch openingImage state = some (.base instruction) := by
  have current : state.pc.toNat = 4096+4*index := by
    rw [pc, BitVec.toNat_ofNat, Nat.mod_eq_of_lt]
    omega
  rw [fetch, current, ite_eq_left (by omega), show (4096+4*index-4096)/4=index by omega]
  cases code : openingImage.code[index]? with
  | none => simp [code] at decoded
  | some word =>
    simp [code, Opening.decodeBase] at decoded
    cases dec : decodeInstruction word with
    | none => simp [dec] at decoded
    | some result =>
      cases result with
      | base inst =>
        simp [dec] at decoded
        simpa [decoded] using dec
      | word op rd rs₁ rs₂ => simp [dec] at decoded
      | sraiw rd rs sh => simp [dec] at decoded

/-- `packed_fetch_base` for every row of the 930-word image (the link calls at 896..929 included). -/
theorem packed_fetch_ext (state : MachineState) (index : Nat) (instruction : Instr)
    (bounded : index < 930) (pc : state.pc = BitVec.ofNat 64 (4096+4*index))
    (decoded : (openingImage.code[index]?).bind Opening.decodeBase = some instruction) :
    fetch openingImage state = some (.base instruction) := by
  have current : state.pc.toNat = 4096+4*index := by
    rw [pc, BitVec.toNat_ofNat, Nat.mod_eq_of_lt]
    omega
  rw [fetch, current, ite_eq_left (by omega), show (4096+4*index-4096)/4=index by omega]
  cases code : openingImage.code[index]? with
  | none => simp [code] at decoded
  | some word =>
    simp [code, Opening.decodeBase] at decoded
    cases dec : decodeInstruction word with
    | none => simp [dec] at decoded
    | some result =>
      cases result with
      | base inst =>
        simp [dec] at decoded
        simpa [decoded] using dec
      | word op rd rs₁ rs₂ => simp [dec] at decoded
      | sraiw rd rs sh => simp [dec] at decoded

/-- `packed_fetch_base` for every row of the image, including the appended copy paths. -/
theorem packed_fetch_all (state : MachineState) (index : Nat) (instruction : Instr)
    (bounded : index < 7872) (pc : state.pc = BitVec.ofNat 64 (4096+4*index))
    (decoded : (openingImage.code[index]?).bind Opening.decodeBase = some instruction) :
    fetch openingImage state = some (.base instruction) := by
  have current : state.pc.toNat = 4096+4*index := by
    rw [pc, BitVec.toNat_ofNat, Nat.mod_eq_of_lt]
    omega
  rw [fetch, current, ite_eq_left (by omega), show (4096+4*index-4096)/4=index by omega]
  cases code : openingImage.code[index]? with
  | none => simp [code] at decoded
  | some word =>
    simp [code, Opening.decodeBase] at decoded
    cases dec : decodeInstruction word with
    | none => simp [dec] at decoded
    | some result =>
      cases result with
      | base inst =>
        simp [dec] at decoded
        simpa [decoded] using dec
      | word op rd rs₁ rs₂ => simp [dec] at decoded
      | sraiw rd rs sh => simp [dec] at decoded

theorem packed_fetch_base_any (state : MachineState) (index : Nat) (instruction : Instr)
    (bounded : index < 1062) (pc : state.pc = BitVec.ofNat 64 (4096+4*index))
    (decoded : (openingImage.code[index]?).bind Opening.decodeBase = some instruction) :
    fetch openingImage state = some (.base instruction) :=
  packed_fetch_all state index instruction (by omega) pc decoded

section
set_option maxRecDepth 32768
set_option maxHeartbeats 12000000
open CommitGolf.ArtifactEncoding
theorem decode_join (bits : Nat) {n m : Nat} (l : Packed n) (r : Packed m) :
    decode bits (Packed.join l r) = decode bits l ++ decode bits r := by
  unfold decode
  rw [List.ofFn_add]
  congr 1
  · apply congrArg List.ofFn
    funext i
    rw [get_join_left bits l r _ i.isLt]
    rfl
  · apply congrArg List.ofFn
    funext i
    have outside : ¬ (i.natAdd n).val < n := by
      change ¬ n + i.val < n
      omega
    rw [get_join_right bits l r _ outside]
    apply congrArg (r.get bits)
    apply Fin.ext
    change n + i.val - n = i.val
