theorem record_bytes : sizeTable.toList.sum = 534 := by decide +kernel

theorem phase_alignment (ordinal field byte : Nat) :
    (534*ordinal+field+byte)%8=(6*(ordinal%4)+field+byte)%8 := by omega

def recordCost (n : Nat) : Nat :=
  1914*(n/4) + (costTable.toList.take (n%4)).sum

theorem phase_costs : costTable.toList.sum=1914 := by decide +kernel

theorem recordCost_step (n : Nat) (p : Fin 4) (phase : p.val=n%4) :
    recordCost (n+1)= recordCost n + phaseCost p := by
  fin_cases p
  all_goals first | change 0=n%4 at phase | change 1=n%4 at phase | change 2=n%4 at phase | change 3=n%4 at phase
  all_goals unfold recordCost
  all_goals rw [←phase]
  · rw [show (n+1)%4=1 by omega,show (n+1)/4=n/4 by omega]; rfl
  · rw [show (n+1)%4=2 by omega,show (n+1)/4=n/4 by omega]
    change 1914*(n/4)+(404+532)=1914*(n/4)+404+532
    omega
  · rw [show (n+1)%4=3 by omega,show (n+1)/4=n/4 by omega]
    change 1914*(n/4)+(404+532+446)=1914*(n/4)+(404+532)+446
    omega
  · rw [show (n+1)%4=0 by omega,show (n+1)/4=n/4+1 by omega]
    change 1914*(n/4+1)+0=1914*(n/4)+1382+532
    omega

