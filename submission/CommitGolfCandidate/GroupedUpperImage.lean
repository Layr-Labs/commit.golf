theorem fetch_l21_setup (s : MachineState) (i : Fin 7) (pc : s.pc=BitVec.ofNat 64 (4096+4*(46162+i.val))) :
    fetch packedWideCommitImage s=some (.base ((l21SetupOps[i.val]?).getD .EBREAK)) := by
  have hi := i.isLt
  rw [packed_index_fetch s _ pc (by omega) (by omega)]
  fin_cases i <;> rfl

theorem fetch_heap_setup (s : MachineState) (i : Fin 7) (pc : s.pc=BitVec.ofNat 64 (4096+4*(95323+i.val))) :
    fetch packedWideCommitImage s=some (.base ((heapSetupOps[i.val]?).getD .EBREAK)) := by
  have hi := i.isLt
  rw [packed_index_fetch s _ pc (by omega) (by omega)]
