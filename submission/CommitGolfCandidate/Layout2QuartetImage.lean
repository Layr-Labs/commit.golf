      (∀ d : Cell, t.getMem (key B d) = s.getMem (addr (B+16+8*wordAt false q d))) ∧
      (∀ a : Word, (∀ d, a≠key B d) → t.getMem a=s.getMem a) ∧
      (∀ r : Reg, r≠.x28 → r≠.x29 → t.getReg r=s.getReg r) := by
  have len:=(kernel_layout q).1
  obtain ⟨t,run,atTail,h⟩ := run_rows_kernel base aligned room (kernel q) (body q) s startModel
    (initial s B) here (by rw [len];unfold body;have four:=q.isLt;omega) (decoded_rows q)
  rw [len] at run atTail
  refine ⟨t,run,atTail,?_,h.frame,h.fixed⟩
  intro d
  simpa only [(kernel_layout q).2 d,value,key] using h.cells d

