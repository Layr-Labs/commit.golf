theorem decoded_rows : ∀ q : Fin 4, RowsAt checkImage (body q) (kernel q) := by
  intro q;fin_cases q <;> intro i <;> fin_cases i <;> rfl

theorem kernel_run (s : MachineState) (B : Nat) (q : Fin 4) (base : s.getReg .x8=addr B)
