def tile0At (refIdx : Nat) : BitVec 32 :=
  BitVec.ofNat 32 (tile0C64 (refIdx / 64) >>> (32 * (refIdx % 64)))

private theorem nat_slice_word (x d j k : Nat) (hj : j < k) :
    (((x >>> (32 * d)) % (2 ^ (32 * k))) >>> (32 * j)) % (2 ^ 32) = (x >>> (32 * (d + j))) % (2 ^ 32) := by
  simp only [Nat.shiftRight_eq_div_pow]
  have h1 : 2 ^ (32 * k) = 2 ^ (32 * j) * 2 ^ (32 * (k - j)) := by
    rw [← Nat.pow_add]; congr 1; omega
  have h2 : 2 ^ (32 * (k - j)) = 2 ^ 32 * 2 ^ (32 * (k - j - 1)) := by
    rw [← Nat.pow_add]; congr 1; omega
  rw [h1, Nat.mod_mul_right_div_self, h2, Nat.mod_mul_right_mod]
  rw [Nat.div_div_eq_div_mul, ← Nat.pow_add]
  rw [show 32 * d + 32 * j = 32 * (d + j) by omega]

private theorem chunk_slice_eq (p q d s k i : Nat)
    (heq : (p >>> (32 * d)) % (2 ^ (32 * k)) = (q >>> (32 * s)) % (2 ^ (32 * k)))
    (hlo : d ≤ i) (hhi : i < d + k) :
    BitVec.ofNat 32 (p >>> (32 * i)) = BitVec.ofNat 32 (q >>> (32 * (s + (i - d)))) := by
  apply BitVec.eq_of_toNat_eq
  simp only [BitVec.toNat_ofNat]
  have h1 := nat_slice_word p d (i - d) k (by omega)
  have h2 := nat_slice_word q s (i - d) k (by omega)
  rw [show d + (i - d) = i by omega] at h1
  rw [← h1, heq, h2]

private def TileRangeMatches {count : Nat} (packed : ArtifactEncoding.Packed count) (offset : Nat) : Prop :=
  ∀ i : Fin count, 38≤offset+i.val → offset+i.val<181038 →
    packed.get 32 i = tile0At ((offset+i.val-38)%45250+38)

private theorem tile_range_join {leftCount rightCount : Nat}
    (left : ArtifactEncoding.Packed leftCount) (right : ArtifactEncoding.Packed rightCount)
    (offset : Nat) (first : TileRangeMatches left offset)
    (last : TileRangeMatches right (offset+leftCount)) :
    TileRangeMatches (.join left right) offset := by
  intro index lower upper
  by_cases inside : index.val<leftCount
  · rw [ArtifactEncoding.get_join_left 32 left right index inside]
    exact first ⟨index.val,inside⟩ lower upper
  · rw [ArtifactEncoding.get_join_right 32 left right index inside]
    have position : offset+leftCount+(index.val-leftCount)=offset+index.val := by omega
    have equal := last ⟨index.val-leftCount,by omega⟩ (by simpa only [position] using lower)
      (by simpa only [position] using upper)
    simpa only [position] using equal

private theorem tile_range_skip (count payload offset : Nat)
    (out : offset + count ≤ 38 ∨ 181038 ≤ offset) :
    TileRangeMatches (.chunk count payload) offset := by
  intro i lo hi; have := i.isLt; omega

private theorem seg_match (p offset d k t rc s i : Nat)
    (h1 : offset + d ≥ 38 + 45250 * t)
    (h2 : offset + d + k ≤ 38 + 45250 * (t + 1))
    (h3 : (offset + d - (38 + 45250 * t)) + 38 = 64 * rc + s)
    (h4 : s + k ≤ 64)
    (heq : (p >>> (32 * d)) % (2 ^ (32 * k)) = (tile0C64 rc >>> (32 * s)) % (2 ^ (32 * k)))
    (hlo : d ≤ i) (hhi : i < d + k) :
    BitVec.ofNat 32 (p >>> (32 * i)) = tile0At ((offset + i - 38) % 45250 + 38) := by
  have hmod : (offset + i - 38) % 45250 + 38 = 64 * rc + (s + (i - d)) := by
    have e1 : offset + i - 38 = (offset + i - (38 + 45250 * t)) + 45250 * t := by omega
    rw [e1, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt (by omega)]
    omega
  rw [hmod, tile0At, show (64 * rc + (s + (i - d))) / 64 = rc by omega,
    show (64 * rc + (s + (i - d))) % 64 = s + (i - d) by omega]
  exact chunk_slice_eq p (tile0C64 rc) d s k i heq hlo hhi

private theorem tile_chunk_1 (count p offset d k t rc s : Nat)
    (ha : offset + d ≤ 38 ∨ d = 0)
    (hb : 181038 ≤ offset + d + k ∨ d + k = count)
    (h1 : offset + d ≥ 38 + 45250 * t)
    (h2 : offset + d + k ≤ 38 + 45250 * (t + 1))
    (h3 : (offset + d - (38 + 45250 * t)) + 38 = 64 * rc + s ∧ s + k ≤ 64)
    (heq : (p >>> (32 * d)) % (2 ^ (32 * k)) = (tile0C64 rc >>> (32 * s)) % (2 ^ (32 * k))) :
    TileRangeMatches (.chunk count p) offset := by
  intro i lo hi; have := i.isLt
  exact seg_match p offset d k t rc s i.val h1 h2 h3.1 h3.2 heq (by omega) (by omega)

private theorem tile_chunk_2 (count p offset d1 k1 t1 rc1 s1 k2 t2 rc2 s2 : Nat)
    (ha : offset + d1 ≤ 38 ∨ d1 = 0)
    (hb : 181038 ≤ offset + d1 + k1 + k2 ∨ d1 + k1 + k2 = count)
    (h1 : offset + d1 ≥ 38 + 45250 * t1)
    (h2 : offset + d1 + k1 ≤ 38 + 45250 * (t1 + 1))
    (h3 : (offset + d1 - (38 + 45250 * t1)) + 38 = 64 * rc1 + s1 ∧ s1 + k1 ≤ 64)
    (h4 : offset + (d1 + k1) ≥ 38 + 45250 * t2)
    (h5 : offset + (d1 + k1) + k2 ≤ 38 + 45250 * (t2 + 1))
    (h6 : (offset + (d1 + k1) - (38 + 45250 * t2)) + 38 = 64 * rc2 + s2 ∧ s2 + k2 ≤ 64)
    (heq1 : (p >>> (32 * d1)) % (2 ^ (32 * k1)) = (tile0C64 rc1 >>> (32 * s1)) % (2 ^ (32 * k1)))
    (heq2 : (p >>> (32 * (d1 + k1))) % (2 ^ (32 * k2)) = (tile0C64 rc2 >>> (32 * s2)) % (2 ^ (32 * k2))) :
    TileRangeMatches (.chunk count p) offset := by
  intro i lo hi; have := i.isLt
