/-- Opening image with the three compactors. -/
def openingImage : Image := ⟨[openingChunk0, openingChunk1, openingChunk2, openingChunk3, openingChunk4, openingChunk5, openingChunk6, openingChunk7, openingChunk8, openingChunk9, openingChunk10, openingChunk11, openingChunk12, openingChunk13, openingChunk14, openingChunk15, openingChunk16, openingChunk17, openingChunk18, openingChunk19, openingChunk20, openingChunk21, openingChunk22, openingChunk23, openingChunk24, openingChunk25, openingChunk26, openingChunk27, openingChunk28, openingChunk29, openingChunk30, openingChunk31, openingChunk32, openingChunk33, openingChunk34, openingChunk35, openingChunk36, openingChunk37, openingChunk38, openingChunk39, openingChunk40, openingChunk41, openingChunk42, openingChunk43, openingChunk44, openingChunk45, openingChunk46, openingChunk47].flatten, []⟩

theorem packed_fetch_raw (state : MachineState) (index : Nat) (instruction : Instr)
    (indexBound : index < 4747) (pc : state.pc = BitVec.ofNat 64 (4096 + 4 * index))
    (decoded : (openingImage.code[index]?).bind decodeInstruction = some (.base instruction)) :
    fetch openingImage state = some (.base instruction) := by
  have pcNat : state.pc.toNat = 4096 + 4 * index := by
    rw [pc, BitVec.toNat_ofNat, Nat.mod_eq_of_lt]
    omega
  rw [fetch, pcNat, ite_eq_left (by omega)]
  rw [show (4096 + 4 * index - 4096) / 4 = index by omega]
  cases word : openingImage.code[index]? with
  | none => simp [word] at decoded
  | some word => simpa [word] using decoded


theorem packed_fetch_base (state : MachineState) (index : Nat) (instruction : Instr)
    (bounded : index < 667) (pc : state.pc = BitVec.ofNat 64 (4096+4*index))
    (decoded : (openingImage.code[index]?).bind Opening.decodeBase = some instruction) :
    fetch openingImage state = some (.base instruction) := by
  have current : state.pc.toNat = 4096+4*index := by
    rw [pc, BitVec.toNat_ofNat, Nat.mod_eq_of_lt]
    omega
  rw [fetch, current, ite_eq_left (by omega), show (4096+4*index-4096)/4=index by omega]
  cases code : openingImage.code[index]? with
  | none => simp [code] at decoded
  | some word =>
    simp [code, Opening.decodeBase] at decoded
    cases dec : decodeInstruction word with
    | none => simp [dec] at decoded
    | some result =>
      cases result with
      | base inst =>
        simp [dec] at decoded
        simpa [decoded] using dec
      | word op rd rs₁ rs₂ => simp [dec] at decoded
      | sraiw rd rs sh => simp [dec] at decoded

/-- Each copy site names the first of its adjacent LHU/SH instruction pairs. -/
inductive CopySite where
  | nonce
  | firstSibling
  | sibling (level : Fin 15)
  | cap

def CopySite.start : CopySite → Nat
  | .nonce => 16
  | .firstSibling => 37
  | .sibling level => 74+35*level.val
  | .cap => 624

def CopySite.halfwords : CopySite → Nat
  | .nonce => 8
  | .firstSibling => 16
  | .sibling _ | .cap => 15

def copyLoad (offset : Nat) : Instr := .LHU .x31 .x7 (BitVec.ofNat 12 (2*offset))
def copyStore (offset : Nat) : Instr := .SH .x21 .x31 (BitVec.ofNat 12 (2*offset))

def PairDecodes (site : CopySite) (offset : Nat) : Prop :=
    (openingImage.code[site.start+2*offset]?).bind Opening.decodeBase = some (copyLoad offset) ∧
    (openingImage.code[site.start+2*offset+1]?).bind Opening.decodeBase = some (copyStore offset)

private instance (site : CopySite) (offset : Nat) : Decidable (PairDecodes site offset) := by
  unfold PairDecodes
  infer_instance

set_option maxHeartbeats 2500000 in
theorem copy_sites_decoded (site : CopySite) (offset : Fin site.halfwords) :
    PairDecodes site offset.val := by
  cases site with
  | nonce => exact (show ∀ i : Fin 8, PairDecodes .nonce i.val by decide) offset
  | firstSibling => exact (show ∀ i : Fin 16, PairDecodes .firstSibling i.val by decide) offset
  | sibling level =>
    exact (show ∀ j i : Fin 15, PairDecodes (.sibling j) i.val by decide) level offset
  | cap => exact (show ∀ i : Fin 15, PairDecodes .cap i.val by decide) offset

theorem copy_site_inside (site : CopySite) (offset : Fin site.halfwords) :
    site.start+2*offset.val+1 < 667 := by
  cases site <;> have h := offset.isLt <;> simp [CopySite.start, CopySite.halfwords] at * <;> omega

theorem fetch_copy_load (site : CopySite) (offset : Fin site.halfwords) (state : MachineState)
    (pc : state.pc = BitVec.ofNat 64 (4096+4*(site.start+2*offset.val))) :
    fetch openingImage state = some (.base (copyLoad offset.val)) :=
  packed_fetch_base _ _ _ (by have := copy_site_inside site offset; omega) pc
    (copy_sites_decoded site offset).1

theorem fetch_copy_store (site : CopySite) (offset : Fin site.halfwords) (state : MachineState)
    (pc : state.pc = BitVec.ofNat 64 (4096+4*(site.start+2*offset.val+1))) :
    fetch openingImage state = some (.base (copyStore offset.val)) :=
  packed_fetch_base _ _ _ (copy_site_inside site offset) pc
    (copy_sites_decoded site offset).2

end TwoPermutationPrototype.PackedOpening
